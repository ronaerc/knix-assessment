{% comment %}
  Section: Best Sellers
  File: sections/best-sellers.liquid
{% endcomment %}

<section class="best-sellers tw-py-8 md:tw-py-12 lg:tw-py-16">
  <div class="tw-max-w-7xl tw-mx-auto tw-px-4 md:tw-px-6 lg:tw-px-8">
    <!-- Header -->
    <div class="tw-flex tw-items-center tw-justify-between tw-mb-6 md:tw-mb-8">
      <h2 class="tw-text-2xl md:tw-text-3xl lg:tw-text-4xl tw-font-black tw-text-gray-900">
        {{ section.settings.heading }}
      </h2>
      {% if section.settings.show_view_all %}
        <a 
          href="{{ section.settings.view_all_link }}" 
          class="tw-hidden md:tw-flex tw-items-center tw-gap-2 tw-text-sm tw-text-gray-600 hover:tw-text-gray-900 tw-transition-colors"
        >
          {{ section.settings.view_all_text }}
          <svg xmlns="http://www.w3.org/2000/svg" class="tw-h-4 tw-w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      {% endif %}
    </div>
  </div>

  <!-- Desktop Slider -->
  <div class="tw-hidden md:tw-block">
    <div 
      id="desktop-slider-{{ section.id }}" 
      class="tw-flex tw-gap-6 tw-overflow-x-auto tw-pb-4 tw-px-4 md:tw-px-6 lg:tw-px-8 tw-scroll-smooth scrollbar-hide"
      style="scroll-snap-type: x mandatory;"
    >
      <!-- Left spacer for max-width alignment -->
      <div class="tw-flex-shrink-0 tw-w-[calc((100vw-80rem)/2+1rem)] tw-max-w-[calc((100vw-80rem)/2+1rem)] tw-min-w-0 tw-hidden xl:tw-block"></div>
      
      {% for block in section.blocks %}
        <div class="tw-flex-shrink-0 tw-w-[280px] lg:tw-w-[300px]" style="scroll-snap-align: start;">
          {% render 'best-seller-card', block: block, index: forloop.index %}
        </div>
      {% endfor %}
      
      <!-- Right spacer -->
      <div class="tw-flex-shrink-0 tw-w-4 md:tw-w-6 lg:tw-w-8"></div>
    </div>

    <!-- Progress Bar -->
    <div class="tw-max-w-7xl tw-mx-auto tw-px-4 md:tw-px-6 lg:tw-px-8 tw-mt-6">
      <div class="tw-h-0.5 tw-bg-gray-200 tw-rounded-full tw-overflow-hidden">
        <div 
          id="progress-bar-{{ section.id }}" 
          class="tw-h-full tw-bg-gray-900 tw-rounded-full tw-transition-all tw-duration-150"
          style="width: 30%;"
        ></div>
      </div>
    </div>
  </div>

  <!-- Mobile Grid -->
  <div class="md:tw-hidden tw-px-4">
    <!-- Visible products (first 4) -->
    <div class="tw-grid tw-grid-cols-2 tw-gap-4">
      {% for block in section.blocks limit: 4 %}
        {% render 'best-seller-card', block: block, index: forloop.index %}
      {% endfor %}
    </div>

    <!-- Hidden products container -->
    {% if section.blocks.size > 4 %}
      <div 
        id="mobile-hidden-products-{{ section.id }}" 
        class="tw-grid tw-grid-cols-2 tw-gap-4 tw-overflow-hidden tw-transition-all tw-duration-500 tw-ease-in-out"
        style="max-height: 0; opacity: 0; margin-top: 0;"
      >
        {% for block in section.blocks offset: 4 %}
          <div class="tw-pt-4 first:tw-pt-4">
            {% render 'best-seller-card', block: block, index: forloop.index | plus: 4 %}
          </div>
        {% endfor %}
      </div>

      <!-- Show More Button -->
      <div class="tw-flex tw-justify-center tw-mt-6">
        <button 
          id="show-more-btn-{{ section.id }}"
          class="tw-bg-gray-900 tw-text-white tw-px-8 tw-py-3 tw-rounded-full tw-text-sm tw-font-medium hover:tw-bg-gray-800 tw-transition-colors tw-w-full tw-max-w-xs"
          onclick="toggleProducts('{{ section.id }}')"
        >
          {{ section.settings.show_more_text }}
        </button>
      </div>
    {% endif %}
  </div>
</section>

<style>
  /* Hide scrollbar but keep functionality */
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  // Mobile toggle functionality
  function toggleProducts(sectionId) {
    const hiddenProducts = document.getElementById('mobile-hidden-products-' + sectionId);
    const button = document.getElementById('show-more-btn-' + sectionId);
    const isExpanded = hiddenProducts.style.maxHeight !== '0px';

    if (isExpanded) {
      hiddenProducts.style.maxHeight = '0';
      hiddenProducts.style.opacity = '0';
      hiddenProducts.style.marginTop = '0';
      button.textContent = '{{ section.settings.show_more_text }}';
    } else {
      hiddenProducts.style.maxHeight = hiddenProducts.scrollHeight + 'px';
      hiddenProducts.style.opacity = '1';
      hiddenProducts.style.marginTop = '1rem';
      button.textContent = '{{ section.settings.show_less_text }}';
    }
  }

  // Desktop slider progress bar
  document.addEventListener('DOMContentLoaded', function() {
    const slider = document.getElementById('desktop-slider-{{ section.id }}');
    const progressBar = document.getElementById('progress-bar-{{ section.id }}');
    
    if (slider && progressBar) {
      function updateProgressBar() {
        const scrollLeft = slider.scrollLeft;
        const scrollWidth = slider.scrollWidth - slider.clientWidth;
        const scrollPercentage = scrollWidth > 0 ? (scrollLeft / scrollWidth) * 100 : 0;
        
        // Calculate width based on visible portion + scroll position
        const visibleRatio = slider.clientWidth / slider.scrollWidth;
        const barWidth = Math.max(visibleRatio * 100, 20); // Minimum 20% width
        const maxLeft = 100 - barWidth;
        const leftPosition = (scrollPercentage / 100) * maxLeft;
        
        progressBar.style.width = barWidth + '%';
        progressBar.style.marginLeft = leftPosition + '%';
      }
      
      slider.addEventListener('scroll', updateProgressBar);
      window.addEventListener('resize', updateProgressBar);
      updateProgressBar();
    }
  });
</script>

{% schema %}
{
  "name": "Best Sellers",
  "tag": "section",
  "class": "best-sellers-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best Sellers"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Text",
      "default": "Shop All Best Sellers"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    },
    {
      "type": "text",
      "id": "show_more_text",
      "label": "Show More Button Text",
      "default": "Show More"
    },
    {
      "type": "text",
      "id": "show_less_text",
      "label": "Show Less Button Text",
      "default": "Show Less"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image (optional)"
        },
        {
          "type": "image_picker",
          "id": "hover_image",
          "label": "Hover Image (optional)"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Card Background Color",
          "default": "#f5f5f5"
        },
        {
          "type": "checkbox",
          "id": "show_best_seller_badge",
          "label": "Show Best Seller Badge",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_sale_badge",
          "label": "Show Sale Badge",
          "default": false
        },
        {
          "type": "text",
          "id": "sale_badge_text",
          "label": "Sale Badge Text",
          "default": "SAVE 10%"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Best Sellers",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}