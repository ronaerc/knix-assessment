{% if section.blocks.size > 0 %}
<section class="tw-bg-hidden-dark tw-border-y tw-border-white/10" aria-label="Product features">
  <h2 class="tw-sr-only">Product Features</h2>
  <div class="lg:tw-container lg:tw-mx-auto lg:tw-px-6 sm:tw-w-full lg:w-auto">
    <ul class="tw-grid tw-grid-cols-1 sm:tw-grid-cols-2 lg:tw-grid-cols-4" role="list">
      {% for block in section.blocks %}
        {% comment %} Calculate position {% endcomment %}
        {% assign remainder = forloop.index | modulo: 2 %}
        
        {% assign is_first_col = false %}
        {% if remainder == 1 %}
          {% assign is_first_col = true %}
        {% endif %}
        
        {% assign is_last_row = false %}
        {% if forloop.index > 2 %}
          {% assign is_last_row = true %}
        {% endif %}
        <li class="tw-py-8 md:tw-px-6 tw-text-center
          {% unless forloop.last %}tw-border-b{% endunless %}
      
      {% if is_first_col %}sm:tw-border-r{% endif %}
      {% if is_last_row %}sm:tw-border-b-0{% endif %}
      
      {% unless forloop.last %}lg:tw-border-r{% endunless %}
      lg:tw-border-b-0 tw-border-white/10
          ">
          
          {% if block.settings.feature_link != blank %}
            <a href="{{ block.settings.feature_link }}"></a>
          {% endif %}
          <!-- Hide the container from screenreaders as it's jutst decorative -->
          <div class="tw-inline-flex tw-items-center tw-justify-center tw-w-12 tw-h-12 tw-mb-4 tw-rotate-45 tw-bg-gradient-to-br tw-from-hidden-peach tw-to-hidden-cyan" aria-hidden="true">
            {% render 'feature-icon', icon: block.settings.icon, class: 'tw-w-6 tw-h-6 tw-text-black tw--rotate-45', color: block.settings.icon_color %}
          </div>
          <h2 class="tw-text-white tw-font-semibold tw-mb-1">{{ block.settings.title }}</h2>
          <p class="tw-text-gray-500 tw-text-sm">{{ block.settings.description }}</p>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>
{% endif %}

{% schema %}
{
  "name": "Features Bar",
  "max_blocks": 5,
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "mountain", "label": "Mountain" },
            { "value": "shield", "label": "Shield" },
            { "value": "star", "label": "Star" },
            { "value": "bolt", "label": "Bolt" },
            { "value": "circle", "label": "circle" }
          ],
          "default": "bolt"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature Title"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Feature description here"
        },
        {
          "type": "color",
          "id": "icon_color",
          "label": "Icon color",
          "default": "#000000"
        },
        {
          "type": "url",
          "id": "feature_link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Features Bar",
      "blocks": [
        { "type": "feature", "settings": { "icon": "mountain", "title": "All-Mountain", "description": "Versatile performance" } },
        { "type": "feature", "settings": { "icon": "shield", "title": "Durable Core", "description": "Built to last" } },
        { "type": "feature", "settings": { "icon": "star", "title": "Award Winning", "description": "Industry recognized" } },
        { "type": "feature", "settings": { "icon": "bolt", "title": "Responsive", "description": "Instant feedback" } },
        { "type": "feature", "settings": { "icon": "circle", "title": "cirlce", "description": "its infinite" } }
      ]
    }
  ]
}
{% endschema %}