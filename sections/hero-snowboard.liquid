
<style>
  @media (prefers-reduced-motion: reduce) {
    .gradient-animate {
      animation: none;
    }
  }

  .gradient-animate {
    background: linear-gradient(
      45deg,
      #f4a985,
      #f28b5f,
      #e966a0,
      #d44d9a,
      #9b8ec4,
      #5ec4d4,
      #f4a985
    );
    background-size: 400% 400%;
    animation: gradient-shift 15s ease infinite;
    filter: blur(80px);
  }
  
  @keyframes gradient-shift {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }
</style>

<section class="tw-relative tw-min-h-screen tw-bg-hidden-black tw-overflow-hidden tw-z-0">
  <!-- Gradient Accent Background 
  <div class="tw-absolute tw-inset-0">
    <div class="tw-absolute tw-top-0 tw-right-0 tw-w-1/2 tw-h-full tw-bg-gradient-to-b tw-from-hidden-peach tw-via-hidden-pink tw-via-hidden-red tw-to-hidden-cyan tw-blur-3xl"></div>
  </div>
  -->
  <!-- Animated Gradient Background -->
  <div class="tw-absolute tw-inset-0" aria-hidden="true">
    <div class="tw-absolute tw-top-0 tw-right-0 tw-w-1/2 tw-h-full gradient-animate"></div>
  </div>
  
  <div class="tw-relative tw-z-10 tw-container tw-mx-auto tw-px-6 tw-py-20 tw-min-h-screen tw-flex tw-items-center">
    <div class="tw-grid lg:tw-grid-cols-2 tw-gap-12 tw-items-center tw-w-full">
      
      <!-- Text Content -->
      <div class="tw-text-white tw-space-y-8">

        {% if section.settings.badge_text != blank %}
          <span class="tw-inline-block tw-px-4 tw-py-2 tw-bg-white/10 tw-backdrop-blur tw-rounded-full tw-text-sm tw-uppercase tw-tracking-widest">
            {{ section.settings.badge_text }}
          </span>
        {% endif %}
        
        {% assign title = section.settings.product.title | default: section.settings.heading %}
        {% if title != blank %}
          <h1 class="tw-text-5xl lg:tw-text-7xl tw-font-bold tw-leading-tight tw-text-gray-400">
            {{ title }}
          </h1>
        {% endif %}
        
        {% assign description = section.settings.product.description | default: section.settings.subheading %}
        {% if description != blank %}
          <p class="tw-text-xl tw-text-gray-400 tw-max-w-md">
            {{ description | strip_html | truncate: 150 }}
          </p>
        {% endif %}
        
        {% if section.settings.button_text != blank or section.settings.secondary_text != blank %}
          <div class="tw-flex tw-flex-wrap tw-gap-4">
            {% if section.settings.button_text != blank %}
              {% assign button_url = section.settings.product.url | default: section.settings.button_link %}
              <a href="{{ button_url }}" 
                class="tw-inline-block tw-px-8 tw-py-4 tw-bg-gradient-to-r tw-from-hidden-peach tw-via-hidden-pink tw-to-hidden-cyan tw-text-black tw-font-semibold tw-rounded-full hover:tw-opacity-90 tw-transition focus:tw-outline-none focus:tw-ring-2 focus:tw-ring-white focus:tw-ring-offset-2 focus:tw-ring-offset-hidden-black">
                {{ section.settings.button_text }}
              </a>
            {% endif %}
            {% if section.settings.secondary_text != blank and section.settings.secondary_link != blank %}
              <a href="{{ section.settings.secondary_link }}" 
                class="tw-inline-block tw-px-8 tw-py-4 tw-border tw-border-white/30 tw-text-white tw-rounded-full hover:tw-bg-white/10 tw-transition focus:tw-outline-none focus:tw-ring-2 focus:tw-ring-white focus:tw-ring-offset-2 focus:tw-ring-offset-hidden-black">
                {{ section.settings.secondary_text }}
              </a>
            {% endif %}
          </div>
        {% endif %}
        
        <!-- Price Tag -->
        <!-- We use bg-clip-text to clip the background to the text shape. The span is actually 100% width. tw-text-transparent is then used to hide the text color. This goves the text a gradient effect. -->

        {% assign price = section.settings.product.price | default: nil %}
        {% assign fallback_price = section.settings.price %}
        {% liquid
          assign has_price = false
          if price != nil
            assign has_price = true
          elsif fallback_price != blank
            assign has_price = true
          endif
        %}


        {% if section.settings.show_price and has_price %}
        <div class="tw-pt-4">
          <span class="tw-text-gray-500 tw-text-sm tw-uppercase tw-tracking-wide">Starting at</span>
          <span class="tw-block tw-text-3xl tw-font-bold tw-bg-gradient-to-r tw-from-hidden-peach tw-to-hidden-cyan tw-bg-clip-text tw-text-transparent">
            {% if section.settings.product %}
                {{ section.settings.product.price | money }}
              {% else %}
                {{ fallback_price }}
              {% endif %}
          </span>
        </div>
        {% endif %}
      </div>
      
      <!-- Product Image -->
      {% assign product_image = section.settings.product.featured_image | default: section.settings.product_image %}
      {% if product_image != blank %}
      <div class="tw-relative tw-flex tw-justify-center lg:tw-justify-end">
        <div class="tw-relative">
          
          <img src="{{ product_image | image_url: width: 800 }}" 
            srcset="{{ product_image | image_url: width: 400 }} 400w,
                   {{ product_image | image_url: width: 600 }} 600w,
                   {{ product_image | image_url: width: 800 }} 800w,
                   {{ product_image | image_url: width: 1000 }} 1000w,
                   {{ product_image | image_url: width: 1200 }} 1200w"
           sizes="(max-width: 768px) 100vw, 50vw"
                 alt="{{ section.settings.product.featured_image.alt | default: section.settings.product.title | default: section.settings.heading | escape }}"
                 class="tw-relative tw-z-10 lg:tw-max-h-[80vh] tw-max-h-[100vh] tw-w-auto tw-object-contain tw-drop-shadow-2xl hover:tw-rotate-90"
                 width="800"
                 height="auto"
                 fetchpriority="high">
        </div>
      </div>
       {% endif %}
      
    </div>
  </div>
  
  <!-- Scroll Indicator -->
  <div class="tw-absolute tw-bottom-8 tw-left-1/2 tw--translate-x-1/2 tw-text-white/50 tw-animate-bounce">
    <svg class="tw-w-6 tw-h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
    </svg>
  </div>
</section>

{% schema %}
{
  "name": "Hero Snowboard",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "header",
      "content": "Fallback Content",
      "info": "Used when no product is selected"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "New Release 2026"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Hidden Snowboard"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Where stealth meets spectrum. Unleash the hidden colors on every run."
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product Image"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Primary Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_text",
      "label": "Secondary Button Text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show Price",
      "default": true
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price Display",
      "default": "$629.95"
    }
  ],
  "presets": [
    {
      "name": "Hero Snowboard"
    }
  ]
}
{% endschema %}