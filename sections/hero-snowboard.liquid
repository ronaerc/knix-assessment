<section class="tw-relative tw-min-h-screen tw-bg-hidden-black tw-overflow-hidden tw-z-0">
  <!-- Gradient Accent Background -->
  <div class="tw-absolute tw-inset-0">
    <div class="tw-absolute tw-top-0 tw-right-0 tw-w-1/2 tw-h-full tw-bg-gradient-to-b tw-from-hidden-peach tw-via-hidden-pink tw-to-hidden-cyan tw-blur-3xl"></div>
  </div>
  
  <div class="tw-relative tw-z-10 tw-container tw-mx-auto tw-px-6 tw-py-20 tw-min-h-screen tw-flex tw-items-center">
    <div class="tw-grid lg:tw-grid-cols-2 tw-gap-12 tw-items-center tw-w-full">
      
      <!-- Text Content -->
      <div class="tw-text-white tw-space-y-8">
        <span class="tw-inline-block tw-px-4 tw-py-2 tw-bg-white/10 tw-backdrop-blur tw-rounded-full tw-text-sm tw-uppercase tw-tracking-widest">
          {{ section.settings.badge_text }}
        </span>
        
        <h1 class="tw-text-5xl lg:tw-text-7xl tw-font-bold tw-leading-tight tw-text-gray-400">
          {{ section.settings.heading }}
        </h1>
        
        <p class="tw-text-xl tw-text-gray-400 tw-max-w-md">
          {{ section.settings.subheading }}
        </p>
        
        <div class="tw-flex tw-flex-wrap tw-gap-4">
          <a href="{{ section.settings.button_link }}" 
             class="tw-inline-block tw-px-8 tw-py-4 tw-bg-gradient-to-r tw-from-hidden-peach tw-via-hidden-pink tw-to-hidden-cyan tw-text-black tw-font-semibold tw-rounded-full hover:tw-opacity-90 tw-transition">
            {{ section.settings.button_text }}
          </a>
          <a href="{{ section.settings.secondary_link }}" 
             class="tw-inline-block tw-px-8 tw-py-4 tw-border tw-border-white/30 tw-text-white tw-rounded-full hover:tw-bg-white/10 tw-transition">
            {{ section.settings.secondary_text }}
          </a>
        </div>
        
        <!-- Price Tag -->
        {% if section.settings.show_price %}
        <div class="tw-pt-4">
          <span class="tw-text-gray-500 tw-text-sm tw-uppercase tw-tracking-wide">Starting at</span>
          <span class="tw-block tw-text-3xl tw-font-bold tw-bg-gradient-to-r tw-from-hidden-peach tw-to-hidden-cyan tw-bg-clip-text tw-text-transparent">
            {{ section.settings.price }}
          </span>
        </div>
        {% endif %}
      </div>
      
      <!-- Product Image -->
      <div class="tw-relative tw-flex tw-justify-center lg:tw-justify-end">
        <div class="tw-relative">
          <!-- Glow Effect -->
          <div class="tw-absolute tw-inset-0 tw-bg-gradient-to-b tw-from-hidden-peach tw-via-hidden-pink tw-to-hidden-cyan tw-blur-2xl tw-opacity-30 tw-scale-75"></div>
          
          {% if section.settings.product_image %}
            <img src="{{ section.settings.product_image | image_url: width: 800 }}" 
                 alt="{{ section.settings.heading }}"
                 class="tw-relative tw-z-10 tw-max-h-[80vh] tw-w-auto tw-object-contain tw-drop-shadow-2xl">
          {% endif %}
        </div>
      </div>
      
    </div>
  </div>
  
  <!-- Scroll Indicator -->
  <div class="tw-absolute tw-bottom-8 tw-left-1/2 tw--translate-x-1/2 tw-text-white/50 tw-animate-bounce">
    <svg class="tw-w-6 tw-h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
    </svg>
  </div>
</section>

{% schema %}
{
  "name": "Hero Snowboard",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "New Release 2026"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Hidden Snowboard"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Where stealth meets spectrum. Unleash the hidden colors on every run."
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product Image"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Primary Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_text",
      "label": "Secondary Button Text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show Price",
      "default": true
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price Display",
      "default": "$629.95"
    }
  ],
  "presets": [
    {
      "name": "Hero Snowboard"
    }
  ]
}
{% endschema %}