{% comment %}
  Snippet: Best Seller Card
  File: snippets/best-seller-card.liquid
{% endcomment %}

{% assign product = block.settings.product %}
{% assign primary_image = block.settings.custom_image | default: product.featured_image %}
{% assign hover_image = block.settings.hover_image | default: product.images[1] %}
{% assign bg_color = block.settings.background_color | default: '#f5f5f5' %}

<div class="product-card tw-group" {{ block.shopify_attributes }}>
  <!-- Image Container -->
  <a href="{{ product.url }}" class="tw-block tw-relative tw-aspect-square tw-overflow-hidden tw-rounded-lg tw-mb-3" style="background-color: {{ bg_color }};">
    <!-- Badges -->
    <div class="tw-absolute tw-top-2 tw-left-2 tw-right-2 tw-flex tw-justify-between tw-z-10">
      {% if block.settings.show_best_seller_badge %}
        <span class="tw-bg-red-600 tw-text-white tw-text-[10px] tw-font-bold tw-px-2 tw-py-0.5 tw-rounded tw-uppercase tw-tracking-wide">
          Best Seller
        </span>
      {% else %}
        <span></span>
      {% endif %}
      
      {% if block.settings.show_sale_badge %}
        <span class="tw-bg-yellow-400 tw-text-gray-900 tw-text-[10px] tw-font-bold tw-px-2 tw-py-0.5 tw-rounded tw-uppercase tw-tracking-wide">
          {{ block.settings.sale_badge_text }}
        </span>
      {% endif %}
    </div>

    <!-- Primary Image -->
    {% if primary_image %}
      <img 
        src="{{ primary_image | image_url: width: 600 }}"
        alt="{{ product.title | escape }}"
        class="tw-absolute tw-inset-0 tw-w-full tw-h-full tw-object-contain tw-p-4 tw-transition-opacity tw-duration-300 tw-ease-in-out group-hover:tw-opacity-0"
        loading="lazy"
        width="600"
        height="600"
      >
    {% else %}
      {{ 'product-1' | placeholder_svg_tag: 'tw-absolute tw-inset-0 tw-w-full tw-h-full tw-object-contain tw-p-4' }}
    {% endif %}

    <!-- Hover Image -->
    {% if hover_image %}
      <img 
        src="{{ hover_image | image_url: width: 600 }}"
        alt="{{ product.title | escape }}"
        class="tw-absolute tw-inset-0 tw-w-full tw-h-full tw-object-contain tw-p-4 tw-transition-opacity tw-duration-300 tw-ease-in-out tw-opacity-0 group-hover:tw-opacity-100"
        loading="lazy"
        width="600"
        height="600"
      >
    {% endif %}
  </a>

  <!-- Product Info -->
  <div class="tw-space-y-1.5">
    <!-- Title -->
    <a href="{{ product.url }}" class="tw-block">
      <h3 class="tw-text-xs tw-font-bold tw-text-gray-900 tw-uppercase tw-leading-tight tw-line-clamp-2 hover:tw-text-gray-600 tw-transition-colors tw-tracking-wide">
        {{ product.title | default: 'Product Title' }}
      </h3>
    </a>

    <!-- Rating -->
    <div class="tw-flex tw-items-center tw-gap-1.5">
      <div class="tw-flex tw-text-gray-900">
        {% for i in (1..5) %}
          <svg class="tw-w-3 tw-h-3 tw-fill-current" viewBox="0 0 20 20">
            <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
          </svg>
        {% endfor %}
      </div>
      <span class="tw-text-[11px] tw-text-gray-500">1,234 Reviews</span>
    </div>

    <!-- Price -->
    <div class="tw-flex tw-items-center tw-gap-2 tw-pt-0.5">
      <span class="tw-text-sm tw-font-bold tw-text-gray-900">
        {{ product.price | money | default: '$104.95' }}
      </span>
      {% if product.compare_at_price > product.price %}
        <span class="tw-text-xs tw-text-gray-400 tw-line-through">
          {{ product.compare_at_price | money }}
        </span>
      {% endif %}
    </div>
  </div>
</div>